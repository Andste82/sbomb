# Anchored deliberately. An unanchored "sbomb" matches every path component of
# that name, which silently swallowed the whole cmd/sbomb directory: three test
# files were never committed, and CI failed on them for weeks while the local
# tree was green.
/sbomb
/dist/
# generate's default output names, when it runs in the repository root.
/sbomb.cdx.json
/sbomb.spdx.json
.env
*.test
*.pdb

# Claude Code Workspaces 
.claude/

# Devcontainer-local Claude Code state; not part of the project.
.devcontainer/.claude-config/

# Stuff
/_demo/
